---
import '../styles/global.css';
import { profile } from '../data/profile.ts';
import { siteIdentity } from '../data/site.ts';
import { pageSeo } from '../lib/seo.ts';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const { canonical, robots } = pageSeo(Astro.site, Astro.url.pathname, noindex);
// Scrapers need an absolute image URL. Omit origin-dependent tags until SITE_URL exists.
const image = Astro.site ? new URL(siteIdentity.social.path, Astro.site).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.brand} />
    <meta property="og:locale" content={siteIdentity.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(siteIdentity.social.width)} />
        <meta property="og:image:height" content={String(siteIdentity.social.height)} />
        <meta property="og:image:alt" content={siteIdentity.social.alt} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {image && <meta name="twitter:image:alt" content={siteIdentity.social.alt} />}
    <meta name="theme-color" content={siteIdentity.themeColor} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
